# Copy to .env and fill in. List every variable the app reads here (names only, no real values).
# Shared secret for the restaurant routes (GET /orders, POST /orders/:id/advance). Set the same
# value for the service and the kitchen CLI.
KITCHEN_TOKEN=
# Kitchen timer, in seconds per step (default 20; 0 = move that step with the kitchen CLI).
# KITCHEN_AUTO_ADVANCE_SECONDS sets every step; the other three override one step each.
KITCHEN_AUTO_ADVANCE_SECONDS=
KITCHEN_SECONDS_TO_START=
KITCHEN_SECONDS_TO_READY=
KITCHEN_SECONDS_TO_DELIVER=
# Browser origins allowed to send POST and PUT, comma-separated (default http://localhost:5173 and
# http://127.0.0.1:5173). Set it when the builder is served from another address.
ALLOWED_ORIGINS=
