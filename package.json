{
  "name": "pizza-order-builder",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "service": "npm start -w @pizza/service",
    "web": "npm run dev -w @pizza/web",
    "kitchen": "tsx apps/service/src/kitchen-cli.ts",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "fast-check": "^4.10.3",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
